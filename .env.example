# =============================================================================
# NIVARAN GIS 2.0 — Environment Configuration Template (.env.example)
# Problem Statement 26191: Intelligent Hazard-Based Red Zone Identification,
# Carrying Capacity Assessment & Relocation Decision Support System
# =============================================================================
# IMPORTANT: Copy this file to .env.local and fill in only authorized values.
# Never commit real API keys, JWT secrets, or database passwords to version control.

# -----------------------------------------------------------------------------
# 1. Frontend & Gateway Configuration (Vite Client-Safe Variables)
# -----------------------------------------------------------------------------
VITE_APP_NAME="NIVARAN GIS 2.0"
VITE_APP_ENV="development"
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_WS_REALTIME_URL="ws://localhost:8000/ws/events"
VITE_DEFAULT_CRS="EPSG:4326"
VITE_ANALYTICS_CRS="EPSG:32643"

# -----------------------------------------------------------------------------
# 2. Public / Free Geospatial & Weather Feeds (No Key Required by Default)
# -----------------------------------------------------------------------------
VITE_OPEN_METEO_WEATHER_URL="https://api.open-meteo.com/v1/forecast"
VITE_OPEN_METEO_ELEVATION_URL="https://api.open-meteo.com/v1/elevation"
VITE_USGS_EARTHQUAKE_URL="https://earthquake.usgs.gov/fdsnws/event/1/query"
VITE_NOMINATIM_SEARCH_URL="https://nominatim.openstreetmap.org/search"
VITE_OSRM_ROUTING_URL="https://router.project-osrm.org/route/v1/driving"
VITE_DEM_TERRARIUM_TILES="https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png"

# -----------------------------------------------------------------------------
# 3. Official Government & Satellite Feeds (Server-Side / Authorized Adapter)
# Leave blank if not yet provisioned; NIVARAN displays "Not Connected" status
# and accepts manual CAP XML / GeoJSON / CSV imports.
# -----------------------------------------------------------------------------
NDMA_SACHET_CAP_FEED_URL=""
IMD_MAUSAM_API_KEY="YOUR_IMD_API_KEY_HERE"
CWC_FFMS_RIVER_FEED_TOKEN="YOUR_CWC_TOKEN_HERE"
NRSC_BHUVAN_WMS_TOKEN="YOUR_BHUVAN_TOKEN_HERE"
GSI_BHUKOSH_WFS_ENDPOINT=""

# -----------------------------------------------------------------------------
# 4. Backend PostGIS & Security Configuration (Server-Only — Never expose to VITE_*)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://nivaran_app:CHANGE_ME_PASSWORD@localhost:5432/nivaran_postgis"
REDIS_URL="redis://localhost:6379/0"
JWT_SIGNING_SECRET="CHANGE_ME_GENERATE_256_BIT_SECRET"
JWT_ACCESS_EXPIRY_MINUTES="30"
SESSION_IDLE_TIMEOUT_MINUTES="30"
